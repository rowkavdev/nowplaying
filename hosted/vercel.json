{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/card/:id.svg",
      "destination": "/api/card?id=:id"
    },
    {
      "source": "/u/:login.svg",
      "destination": "/api/card?user=:login"
    },
    {
      "source": "/api/auth/github",
      "destination": "/api/auth-github"
    },
    {
      "source": "/healthz",
      "destination": "/api/health"
    },
    {
      "source": "/badges/requests.json",
      "destination": "/api/badge"
    },
    {
      "source": "/badges/pcs.json",
      "destination": "/api/badge-pcs"
    },
    {
      "source": "/badges/users.json",
      "destination": "/api/badge-users"
    },
    {
      "source": "/badges/now.json",
      "destination": "/api/badge-now"
    },
    {
      "source": "/badges/last.json",
      "destination": "/api/badge-last"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
